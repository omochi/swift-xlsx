    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="">
    <sheetData>
        <row r="1">
            <c r="A1" t="s">
                <v>0</v>
            </c>
            <c r="B1" t="s">
                <v>0</v>
            </c>
        </row>
        <row r="2">
            <c r="A2" t="s">
                <v>1</v>
            </c>
        </row>
        <row r="3">
            <c r="A3" t="s">
                <v>2</v>
            </c>
        </row>
    </sheetData>
    <dataValidations count="1">
        <dataValidation sqref="B1" type="list">
            <formula1>$A$1:$A$3</formula1>
        </dataValidation>
    </dataValidations>
</worksheet>
