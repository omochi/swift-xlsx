<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<worksheet
    xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="">
    <cols>
        <col min="1" max="1" width="20.0" customWidth="1"/>
        <col min="3" max="3" width="20.0" customWidth="1"/>
    </cols>
    <sheetData>
        <row r="1">
            <c r="B1">
                <v>10</v>
            </c>
            <c r="C1" t="s">
                <v>0</v>
            </c>
            <c r="D1">
                <f t="shared" si="0" ref="D1:D3">B1*2</f>
                <v>20</v>
            </c>
        </row>
        <row r="2">
            <c r="B2">
                <v>20</v>
            </c>
            <c r="C2" t="s">
                <v>0</v>
            </c>
            <c r="D2">
                <f t="shared" si="0"/>
                <v>40</v>
            </c>
        </row>
        <row r="3">
            <c r="B3">
                <v>30</v>
            </c>
            <c r="C3" t="s">
                <v>0</v>
            </c>
            <c r="D3">
                <f t="shared" si="0"/>
                <v>60</v>
            </c>
        </row>
        <row r="4">
            <c r="A4" t="s">
                <v>1</v>
            </c>
            <c r="B4">
                <f t="normal">SUM(B1:B3)</f>
                <v>60</v>
            </c>
        </row>
        <row r="6">
            <c r="A6" t="s">
                <v>2</v>
            </c>
            <c r="B6" t="str">
                <f t="normal">TEXT(B1,"0")</f>
                <v>10</v>
            </c>
        </row>
    </sheetData>
</worksheet>
